{
  "info": {
    "_postman_id": "2f637273-1231-5c9c-89ce-306113174016",
    "name": "Biblioteca (Yesod)",
    "description": "API da biblioteca. Rode primeiro as duas requisições de **Sessão**: elas guardam `tokenBibliotecario` e `tokenSocio` no ambiente, e cada pasta usa o token do seu perfil. As requisições que criam algo guardam o id devolvido (`livroId`, `pedidoId`, `emprestimoId`...) para as próximas usarem.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Sessão",
      "item": [
        {
          "name": "Entrar como bibliotecário",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/sessoes",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "sessoes"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"login\": \"{{loginBibliotecario}}\",\n  \"senha\": \"{{senhaBibliotecario}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"login aceito\", () => pm.response.to.have.status(201));",
                  "pm.environment.set(\"tokenBibliotecario\", pm.response.json().token);"
