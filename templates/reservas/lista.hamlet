<div .page-header>
    <a .btn .btn-primary .pull-right href=@{ReservaNovaR}>Nova reserva
    <h1>Reservas

<ul .nav .nav-pills .filtros>
    <li :apenasAtivas:.active>
        <a href=@{ReservasR}>Ativas
    <li :not apenasAtivas:.active>
        <a href=@?{(ReservasR, [("status", "todas")])}>Todas

$if null reservas
    <p .text-muted>Nenhuma reserva.
$else
    <table .table .table-striped>
        <thead>
            <tr>
                <th>Livro
                <th>Sócio
                <th>Desde
                <th>Situação
                <th>
        <tbody>
            $forall Entity reservaId reserva <- reservas
                <tr>
                    <td>
                        <a href=@{LivroR (reservaLivroId reserva)}>#{tituloLivro (reservaLivroId reserva)}
                    <td>
                        <a href=@{SocioR (reservaSocioId reserva)}>#{nomeSocio (reservaSocioId reserva)}
                    <td>#{show (reservaDataReserva reserva)}
                    <td>#{show (reservaStatus reserva)}
                    <td>
                        $if reservaStatus reserva == Ativa
                            <form .form-cancelar method=post action=@{ReservaCancelarR reservaId}>
                                $maybe valor <- token
                                    <input type=hidden name=#{defaultCsrfParamName} value=#{valor}>
                                <button .btn .btn-default .btn-xs type=submit>Cancelar
