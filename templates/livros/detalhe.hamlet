<div .row>
    $maybe capa <- livroCapaUrl livro
        <div .col-sm-3>
            <img .img-responsive .capa src=#{capa} alt="Capa de #{livroTitulo livro}">
    <div .col-sm-9>
        <h1>#{livroTitulo livro}
        <dl .dl-horizontal>
            <dt>Autores
            <dd>
                $if null autores
                    —
                $else
                    $forall Entity autorId autor <- autores
                        <a .autor href=@{AutorR autorId}>#{autorNome autor}
            <dt>Categoria
            <dd>#{categoriaNome categoria}
            <dt>Editora
            <dd>#{maybe "—" editoraNome editora}
            <dt>Ano
            <dd>#{maybe "—" tshow (livroAno livro)}
            <dt>ISBN
            <dd>#{fromMaybe "—" (livroIsbn livro)}
        $maybe sinopse <- livroSinopse livro
            <p .sinopse>#{sinopse}

<h3>
    Exemplares
    <a .btn .btn-default .btn-sm href=@{ExemplarNovoR livroId}>Novo exemplar
$if null exemplares
    <p .text-muted>Nenhum exemplar cadastrado.
$else
    <table .table .table-condensed .exemplares>
        <thead>
            <tr>
                <th>Código
                <th>Estado
                <th>Situação
                <th>
        <tbody>
            $forall Entity exemplarId exemplar <- exemplares
                <tr>
                    <td>#{exemplarCodigo exemplar}
                    <td>#{show (exemplarEstado exemplar)}
                    <td>
                        $if exemplarDisponivel exemplar
                            <span .label .label-success>Disponível
                        $else
                            <span .label .label-warning>Emprestado
                    <td>
                        <a href=@{ExemplarEditarR exemplarId}>Editar

<div .acoes>
    <a .btn .btn-default href=@{LivroEditarR livroId}>Editar
    ^{botaoExcluir (LivroExcluirR livroId)}
