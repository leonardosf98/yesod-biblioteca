<div .page-header>
    <h1>#{categoriaNome categoria}
    $maybe descricao <- categoriaDescricao categoria
        <p .lead>#{descricao}

<h3>Livros
$if null livros
    <p .text-muted>Nenhum livro nesta categoria.
$else
    <ul>
        $forall Entity _ livro <- livros
            <li>#{livroTitulo livro}

<div .acoes>
    <a .btn .btn-default href=@{CategoriaEditarR categoriaId}>Editar
    ^{botaoExcluir (CategoriaExcluirR categoriaId)}
