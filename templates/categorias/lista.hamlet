<div .page-header>
    <a .btn .btn-primary .pull-right href=@{CategoriaNovaR}>Nova categoria
    <h1>Categorias

$if null categorias
    <p .text-muted>Nenhuma categoria cadastrada.
$else
    <table .table .table-striped>
        <thead>
            <tr>
                <th>Nome
                <th>Descrição
        <tbody>
            $forall Entity categoriaId categoria <- categorias
                <tr>
                    <td>
                        <a href=@{CategoriaR categoriaId}>#{categoriaNome categoria}
                    <td>#{fromMaybe "—" (categoriaDescricao categoria)}
