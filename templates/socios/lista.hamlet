<div .page-header>
    <a .btn .btn-primary .pull-right href=@{SocioNovoR}>Novo sócio
    <h1>Sócios

$if null socios
    <p .text-muted>Nenhum sócio cadastrado.
$else
    <table .table .table-striped>
        <thead>
            <tr>
                <th>Nome
                <th>E-mail
                <th>Cidade
        <tbody>
            $forall Entity socioId socio <- socios
                <tr>
                    <td>
                        <a href=@{SocioR socioId}>#{socioNome socio}
                    <td>#{socioEmail socio}
                    <td>#{cidadeUf socio}
