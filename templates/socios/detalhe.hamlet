<div .page-header>
    <h1>#{socioNome socio}

<dl .dl-horizontal>
    <dt>E-mail
    <dd>#{socioEmail socio}
    <dt>Telefone
    <dd>#{fromMaybe "—" (socioTelefone socio)}
    <dt>CEP
    <dd>#{fromMaybe "—" (socioCep socio)}
    <dt>Endereço
    <dd .endereco>#{fromMaybe "—" (enderecoCompleto socio)}

<form .form-codigo method=post action=@{SocioCodigoR socioId}>
    $maybe valor <- token
        <input type=hidden name=#{defaultCsrfParamName} value=#{valor}>
    <button .btn .btn-default type=submit>Gerar código de ativação
    <span .help-block>O sócio usa o código para criar a senha do app. Um código novo invalida o anterior.

<h3>Empréstimos
$if null emprestimos
    <p .text-muted>Nenhum empréstimo.
$else
    <table .table .table-condensed .emprestimos>
        <thead>
            <tr>
                <th>Livro
                <th>Exemplar
                <th>Emprestado em
                <th>Devolver até
                <th>Devolvido em
        <tbody>
            $forall Entity _ emprestimo <- emprestimos
                <tr>
                    <td>#{tituloDoExemplar (emprestimoExemplarId emprestimo)}
                    <td>#{codigoDoExemplar (emprestimoExemplarId emprestimo)}
                    <td>#{formatarData (emprestimoDataEmprestimo emprestimo)}
                    <td>#{formatarData (emprestimoDataPrevista emprestimo)}
                    <td>#{maybe "em aberto" formatarData (emprestimoDataDevolucao emprestimo)}

<h3>Reservas
$if null reservas
    <p .text-muted>Nenhuma reserva.
$else
    <ul .reservas>
        $forall Entity _ reserva <- reservas
            <li>#{tituloDoLivro (reservaLivroId reserva)} — #{show (reservaStatus reserva)} desde #{formatarData (reservaDataReserva reserva)}

<div .acoes>
    <a .btn .btn-default href=@{SocioEditarR socioId}>Editar
    ^{botaoExcluir (SocioExcluirR socioId)}
