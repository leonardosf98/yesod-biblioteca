<div .page-header>
    <a .btn .btn-primary .pull-right href=@{EditoraNovaR}>Nova editora
    <h1>Editoras

$if null editoras
    <p .text-muted>Nenhuma editora cadastrada.
$else
    <table .table .table-striped>
        <thead>
            <tr>
                <th>Nome
                <th>Cidade
        <tbody>
            $forall Entity editoraId editora <- editoras
                <tr>
                    <td>
                        <a href=@{EditoraR editoraId}>#{editoraNome editora}
                    <td>#{fromMaybe "—" (editoraCidade editora)}
