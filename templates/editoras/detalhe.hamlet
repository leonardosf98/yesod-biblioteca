<div .page-header>
    <h1>#{editoraNome editora}
    $maybe cidade <- editoraCidade editora
        <p .lead>#{cidade}

<h3>Livros
$if null livros
    <p .text-muted>Nenhum livro desta editora no acervo.
$else
    <ul>
        $forall Entity _ livro <- livros
            <li>#{livroTitulo livro}

<div .acoes>
    <a .btn .btn-default href=@{EditoraEditarR editoraId}>Editar
    ^{botaoExcluir (EditoraExcluirR editoraId)}
