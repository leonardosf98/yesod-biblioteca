<div .page-header>
    <a .btn .btn-primary .pull-right href=@{AutorNovoR}>Novo autor
    <h1>Autores

$if null autores
    <p .text-muted>Nenhum autor cadastrado.
$else
    <table .table .table-striped>
        <thead>
            <tr>
                <th>Nome
                <th>Nacionalidade
        <tbody>
            $forall Entity autorId autor <- autores
                <tr>
                    <td>
                        <a href=@{AutorR autorId}>#{autorNome autor}
                    <td>#{fromMaybe "—" (autorNacionalidade autor)}
