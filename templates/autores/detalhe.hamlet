<div .page-header>
    <h1>#{autorNome autor}
    $maybe nacionalidade <- autorNacionalidade autor
        <p .lead>#{nacionalidade}

<h3>Livros
$if null livros
    <p .text-muted>Nenhum livro deste autor no acervo.
$else
    <ul>
        $forall Entity _ livro <- livros
            <li>#{livroTitulo livro}

<div .acoes>
    <a .btn .btn-default href=@{AutorEditarR autorId}>Editar
    ^{botaoExcluir (AutorExcluirR autorId)}
