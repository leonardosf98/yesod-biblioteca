<div .container>
    <div .page-header>
        <h1>Biblioteca Comunitária
        <p .lead>Gestão de acervo, sócios, empréstimos e reservas.

    <div .row>
        ^{contador "Livros no acervo" livros "contador-livros" "info"}
        ^{contador "Exemplares disponíveis" disponiveis "contador-disponiveis" "success"}
        ^{contador "Sócios" socios "contador-socios" "info"}
        ^{contador "Empréstimos atrasados" atrasados "contador-atrasados" "danger"}
