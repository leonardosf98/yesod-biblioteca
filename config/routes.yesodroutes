/static StaticR Static appStatic
/auth   AuthR   Auth   getAuth

/favicon.ico FaviconR GET
/robots.txt RobotsR GET

/ HomeR GET

/autores AutoresR GET POST
!/autores/novo AutorNovoR GET
/autores/#AutorId AutorR GET POST
/autores/#AutorId/editar AutorEditarR GET
/autores/#AutorId/excluir AutorExcluirR POST

/editoras EditorasR GET POST
!/editoras/nova EditoraNovaR GET
/editoras/#EditoraId EditoraR GET POST
/editoras/#EditoraId/editar EditoraEditarR GET
/editoras/#EditoraId/excluir EditoraExcluirR POST

/categorias CategoriasR GET POST
!/categorias/nova CategoriaNovaR GET
/categorias/#CategoriaId CategoriaR GET POST
/categorias/#CategoriaId/editar CategoriaEditarR GET
/categorias/#CategoriaId/excluir CategoriaExcluirR POST

/livros LivrosR GET POST
!/livros/novo LivroNovoR GET
!/livros/importar LivroImportarR GET POST
/livros/#LivroId LivroR GET POST
/livros/#LivroId/editar LivroEditarR GET
/livros/#LivroId/excluir LivroExcluirR POST

/livros/#LivroId/exemplares ExemplaresR POST
