-- By default this file is used by `persistFileWith` in Model.hs (which is imported by Foundation.hs)
-- Syntax for this file here: https://github.com/yesodweb/persistent/blob/master/docs/Persistent-entity-syntax.md

User
    ident Text
    password Text Maybe
    papel Papel default='PapelSocio'
    socioId SocioId Maybe
    UniqueUser ident
    deriving Typeable
Email
    email Text
    userId UserId Maybe
    verkey Text Maybe
    UniqueEmail email

Autor
    nome Text
    nacionalidade Text Maybe
    deriving Show

Editora
    nome Text
    cidade Text Maybe
    UniqueEditoraNome nome
    deriving Show

Categoria
    nome Text
    descricao Text Maybe
    UniqueCategoriaNome nome
    deriving Show

Livro
    titulo Text
    isbn Text Maybe
    ano Int Maybe
    sinopse Text Maybe
    capaUrl Text Maybe
    editoraId EditoraId Maybe
    categoriaId CategoriaId
    UniqueIsbn isbn !force
    deriving Show

LivroAutor
    livroId LivroId OnDeleteCascade
    autorId AutorId
    Primary livroId autorId
    deriving Show

Exemplar
    livroId LivroId
    codigo Text
    estado EstadoExemplar
    disponivel Bool default=true
    UniqueCodigo codigo
    deriving Show

Socio
    nome Text
    email Text
    telefone Text Maybe
    cep Text Maybe
    logradouro Text Maybe
    numero Text Maybe
    bairro Text Maybe
    cidade Text Maybe
    uf Text Maybe
    UniqueSocioEmail email
    deriving Show

Emprestimo
    exemplarId ExemplarId
    socioId SocioId
    dataEmprestimo Day
    dataPrevista Day
    dataDevolucao Day Maybe
    multaCentavos Int default=0
    renovacoes Int default=0
    multaPagaEm Day Maybe
    deriving Show

Reserva
    livroId LivroId
    socioId SocioId
    dataReserva Day
    status StatusReserva
    deriving Show

Sessao
    userId UserId OnDeleteCascade
    tokenHash Text
    expiraEm UTCTime
    UniqueSessaoToken tokenHash

CodigoAtivacao
    socioId SocioId OnDeleteCascade
    hash Text
    expiraEm UTCTime
    tentativas Int default=0
    UniqueCodigoAtivacaoSocio socioId

Pedido
    exemplarId ExemplarId
    socioId SocioId
    codigo Text
    criadoEm UTCTime
    limiteRetirada UTCTime
    status StatusPedido
    emprestimoId EmprestimoId Maybe
    UniquePedidoCodigo codigo
